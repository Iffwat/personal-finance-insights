# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Database (don't commit personal financial data!)
*.db
*.sqlite
*.sqlite3
data.db

# Keep storage application modules under version control, but ignore generated
# local data and statement files.
storage/*
!storage/*.py
data/

# Virtual Environments
venv/
env/
.env

# Streamlit
.streamlit/

# IDEs and OS files
.vscode/
.idea/
.DS_Store
